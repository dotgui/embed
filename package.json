{
  "name": "@dotgui/embed",
  "version": "0.4.0",
  "description": "Drop-in browser player that renders .gui files anywhere \u2014 one CDN script. Drawn by @dotgui/render, the Rust renderer as WebAssembly.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/gui-embed.esm.js",
  "module": "./dist/gui-embed.esm.js",
  "types": "./src/index.ts",
  "unpkg": "./dist/gui-embed.js",
  "jsdelivr": "./dist/gui-embed.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/gui-embed.esm.js"
    },
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist/",
    "src/",
    "README.md"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build.ts"
  },
  "keywords": [
    "dotgui",
    "gui",
    "embed",
    "web-component",
    "cdn",
    "renderer",
    "wasm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dotgui/embed"
  },
  "dependencies": {
    "@dotgui/kit": "^0.4.1",
    "@dotgui/render": "^0.4.0"
  },
  "devDependencies": {
    "bun-types": "latest",
    "typescript": "^5.0.0"
  }
}
