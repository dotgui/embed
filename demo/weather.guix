<gui version="0.2" name="Weather">
  <tokens>
    <color name="bg" value="#FDF6F0" />
    <color name="card" value="#FFFFFF" />
    <color name="ink" value="#2B2630" />
    <color name="muted" value="#9A93A0" />
    <color name="accent" value="#FF8A65" />
    <color name="blue" value="#7EB6E8" />
    <color name="hero-ink" value="#4A2E22" />
    <color name="day-line" value="#F3EDF0" />
    <color name="track" value="#F0EBEE" />
  </tokens>
  <fonts>
    <font family="SF Pro Display" source="system" weights="300 400 600 700" styles="normal" />
  </fonts>

  <components>
    <component name="Hour" id="comp-hour">
      <props>
        <prop name="t" type="text" target="h-t" />
        <prop name="ic" type="text" target="h-ic" />
        <prop name="deg" type="text" target="h-deg" />
        <prop name="fillc" type="color" target="h-card" />
        <prop name="tc" type="color" target="h-t" />
        <prop name="degc" type="color" target="h-deg" />
      </props>
      <col id="h-card" w="64" p="14 0" fill="$card" radius="22" align="middle-center" gap="8">
        <text id="h-t" value="Now" font-family="SF Pro Display" font-size="12" font-weight="600" color="$muted" />
        <text id="h-ic" value="☀️" font-family="SF Pro Display" font-size="22" />
        <text id="h-deg" value="24°" font-family="SF Pro Display" font-size="15" font-weight="700" color="$ink" />
      </col>
    </component>

    <component name="Metric" id="comp-metric">
      <props>
        <prop name="lab" type="text" target="m-lab" />
        <prop name="val" type="text" target="m-val" />
        <prop name="note" type="text" target="m-note" />
      </props>
      <col w="fill" p="16 18" fill="$card" radius="22" gap="2" role="card">
        <text id="m-lab" value="💧 Humidity" font-family="SF Pro Display" font-size="12" font-weight="700" letter-spacing="0.5" text-case="uppercase" color="$muted" pb="6" />
        <text id="m-val" value="62%" font-family="SF Pro Display" font-size="26" font-weight="600" color="$ink" />
        <text id="m-note" value="Comfortable" font-family="SF Pro Display" font-size="12" color="$muted" />
      </col>
    </component>
  </components>

  <!-- No scroll in .gui: canvas expands to ALL content; the viewport-fixed
       tab bar re-anchors to the BOTTOM of the expanded screen, as a flow child. -->
  <col w="402" fill="$bg">

      <!-- STATUS BAR -->
      <row w="fill" h="50" p="0 26" align="middle-center" gap="auto">
        <text value="9:41" font-family="SF Pro Display" font-size="15" font-weight="600" color="$ink" />
        <row gap="7" align="middle-center">
          <row gap="2" align="bottom-left">
            <rect w="3" h="5" radius="1" fill="$ink" />
            <rect w="3" h="8" radius="1" fill="$ink" />
            <rect w="3" h="10" radius="1" fill="$ink" />
            <rect w="3" h="12" radius="1" fill="$ink" />
          </row>
          <img src="https://api.iconify.design/lucide/wifi.svg?color=%232b2630" w="17" h="12" />
          <img src="https://api.iconify.design/lucide/battery-full.svg?color=%232b2630" w="26" h="13" />
        </row>
      </row>

      <!-- CONTENT -->
      <col w="fill" p="8 22 28">

        <!-- LOCATION -->
        <row w="fill" gap="auto" align="middle-center" pb="18">
          <col gap="2">
            <text value="Santa Monica" font-family="SF Pro Display" font-size="26" font-weight="700" letter-spacing="-0.5" color="$ink" />
            <text value="Updated just now · Mostly Sunny" font-family="SF Pro Display" font-size="13" color="$muted" />
          </col>
          <row w="42" h="42" radius="999" fill="$card" align="middle-center">
            <appearance>
              <fill type="color" value="$card" />
              <effect type="drop-shadow" x="0" y="12" radius="30" color="#9B78641A" />
            </appearance>
            <text value="📍" font-family="SF Pro Display" font-size="18" />
          </row>
        </row>

        <!-- HERO -->
        <col w="fill" p="26 26 22" radius="32" clip>
          <appearance>
            <fill type="linear-gradient" value="linear-gradient(150deg, #FFD5C2 0%, #FFB59A 100%)" />
            <fill type="radial-gradient" value="radial-gradient(circle at 90% 4%, #FFEFA8 0%, #FFD24D 9%, #FFCB8A40 24%, #FFB59A00 46%)" />
            <effect type="drop-shadow" x="0" y="18" radius="40" color="#FF8A654D" />
          </appearance>
          <text value="☀️ Sunny &amp; clear skies" font-family="SF Pro Display" font-size="15" font-weight="600" color="#4A2E22D9" />
          <text pt="6" font-family="SF Pro Display" font-weight="300">
            <segment value="24" font-family="SF Pro Display" font-size="76" font-weight="300" letter-spacing="-3" color="$hero-ink" />
            <segment value="°" font-family="SF Pro Display" font-size="28" font-weight="400" color="$hero-ink" />
          </text>
          <row gap="16" pt="14" align="middle-left">
            <text value="↑ High 27°" font-family="SF Pro Display" font-size="14" font-weight="600" color="#4A2E22CC" />
            <text value="↓ Low 18°" font-family="SF Pro Display" font-size="14" font-weight="600" color="#4A2E22CC" />
            <text value="Feels 25°" font-family="SF Pro Display" font-size="14" font-weight="600" color="#4A2E22CC" />
          </row>
        </col>

        <!-- HOURLY -->
        <text value="HOURLY FORECAST" font-family="SF Pro Display" font-size="13" font-weight="700" letter-spacing="1" text-case="uppercase" color="$muted" pt="26" pb="12" pl="4" />
        <row w="fill" gap="12" clip>
          <instance component="comp-hour" t="Now" ic="☀️" deg="24°" fillc="$accent" tc="#FFFFFFE6" degc="#FFFFFF" />
          <instance component="comp-hour" t="11 AM" ic="☀️" deg="25°" />
          <instance component="comp-hour" t="12 PM" ic="🌤️" deg="26°" />
          <instance component="comp-hour" t="1 PM" ic="🌤️" deg="27°" />
          <instance component="comp-hour" t="2 PM" ic="⛅️" deg="26°" />
          <instance component="comp-hour" t="3 PM" ic="⛅️" deg="25°" />
          <instance component="comp-hour" t="4 PM" ic="🌥️" deg="24°" />
        </row>

        <!-- 7-DAY -->
        <text value="7-DAY FORECAST" font-family="SF Pro Display" font-size="13" font-weight="700" letter-spacing="1" text-case="uppercase" color="$muted" pt="26" pb="12" pl="4" />
        <col w="fill" p="6 18" fill="$card" radius="26">
          <appearance>
            <fill type="color" value="$card" />
            <effect type="drop-shadow" x="0" y="12" radius="30" color="#9B78641A" />
          </appearance>

          <row w="fill" p="13 0" gap="12" align="middle-center" border-bottom="1 $day-line">
            <text w="78" value="Today" font-family="SF Pro Display" font-size="15" font-weight="600" color="$ink" />
            <text w="36" align="center" value="☀️" font-family="SF Pro Display" font-size="20" />
            <text w="30" align="right" value="18°" font-family="SF Pro Display" font-size="14" color="$muted" />
            <frame w="fill" h="6" fill="$track" radius="3" clip>
              <rect abs x="25" y="0" w="87" h="6" radius="3" fill="linear-gradient(90deg, #7EB6E8 0%, #FF8A65 100%)" />
            </frame>
            <text w="30" align="right" value="27°" font-family="SF Pro Display" font-size="14" font-weight="700" color="$ink" />
          </row>

          <row w="fill" p="13 0" gap="12" align="middle-center" border-bottom="1 $day-line">
            <text w="78" value="Tue" font-family="SF Pro Display" font-size="15" font-weight="600" color="$ink" />
            <text w="36" align="center" value="🌤️" font-family="SF Pro Display" font-size="20" />
            <text w="30" align="right" value="17°" font-family="SF Pro Display" font-size="14" color="$muted" />
            <frame w="fill" h="6" fill="$track" radius="3" clip>
              <rect abs x="22" y="0" w="80" h="6" radius="3" fill="linear-gradient(90deg, #7EB6E8 0%, #FF8A65 100%)" />
            </frame>
            <text w="30" align="right" value="25°" font-family="SF Pro Display" font-size="14" font-weight="700" color="$ink" />
          </row>

          <row w="fill" p="13 0" gap="12" align="middle-center" border-bottom="1 $day-line">
            <text w="78" value="Wed" font-family="SF Pro Display" font-size="15" font-weight="600" color="$ink" />
            <text w="36" align="center" value="⛅️" font-family="SF Pro Display" font-size="20" />
            <text w="30" align="right" value="16°" font-family="SF Pro Display" font-size="14" color="$muted" />
            <frame w="fill" h="6" fill="$track" radius="3" clip>
              <rect abs x="27" y="0" w="67" h="6" radius="3" fill="linear-gradient(90deg, #7EB6E8 0%, #FF8A65 100%)" />
            </frame>
            <text w="30" align="right" value="23°" font-family="SF Pro Display" font-size="14" font-weight="700" color="$ink" />
          </row>

          <row w="fill" p="13 0" gap="12" align="middle-center" border-bottom="1 $day-line">
            <text w="78" value="Thu" font-family="SF Pro Display" font-size="15" font-weight="600" color="$ink" />
            <text w="36" align="center" value="🌧️" font-family="SF Pro Display" font-size="20" />
            <text w="30" align="right" value="14°" font-family="SF Pro Display" font-size="14" color="$muted" />
            <frame w="fill" h="6" fill="$track" radius="3" clip>
              <rect abs x="37" y="0" w="50" h="6" radius="3" fill="linear-gradient(90deg, #7EB6E8 0%, #FF8A65 100%)" />
            </frame>
            <text w="30" align="right" value="20°" font-family="SF Pro Display" font-size="14" font-weight="700" color="$ink" />
          </row>

          <row w="fill" p="13 0" gap="12" align="middle-center" border-bottom="1 $day-line">
            <text w="78" value="Fri" font-family="SF Pro Display" font-size="15" font-weight="600" color="$ink" />
            <text w="36" align="center" value="🌦️" font-family="SF Pro Display" font-size="20" />
            <text w="30" align="right" value="15°" font-family="SF Pro Display" font-size="14" color="$muted" />
            <frame w="fill" h="6" fill="$track" radius="3" clip>
              <rect abs x="32" y="0" w="65" h="6" radius="3" fill="linear-gradient(90deg, #7EB6E8 0%, #FF8A65 100%)" />
            </frame>
            <text w="30" align="right" value="22°" font-family="SF Pro Display" font-size="14" font-weight="700" color="$ink" />
          </row>

          <row w="fill" p="13 0" gap="12" align="middle-center" border-bottom="1 $day-line">
            <text w="78" value="Sat" font-family="SF Pro Display" font-size="15" font-weight="600" color="$ink" />
            <text w="36" align="center" value="☀️" font-family="SF Pro Display" font-size="20" />
            <text w="30" align="right" value="17°" font-family="SF Pro Display" font-size="14" color="$muted" />
            <frame w="fill" h="6" fill="$track" radius="3" clip>
              <rect abs x="20" y="0" w="89" h="6" radius="3" fill="linear-gradient(90deg, #7EB6E8 0%, #FF8A65 100%)" />
            </frame>
            <text w="30" align="right" value="26°" font-family="SF Pro Display" font-size="14" font-weight="700" color="$ink" />
          </row>

          <row w="fill" p="13 0" gap="12" align="middle-center">
            <text w="78" value="Sun" font-family="SF Pro Display" font-size="15" font-weight="600" color="$ink" />
            <text w="36" align="center" value="☀️" font-family="SF Pro Display" font-size="20" />
            <text w="30" align="right" value="19°" font-family="SF Pro Display" font-size="14" color="$muted" />
            <frame w="fill" h="6" fill="$track" radius="3" clip>
              <rect abs x="17" y="0" w="97" h="6" radius="3" fill="linear-gradient(90deg, #7EB6E8 0%, #FF8A65 100%)" />
            </frame>
            <text w="30" align="right" value="28°" font-family="SF Pro Display" font-size="14" font-weight="700" color="$ink" />
          </row>
        </col>

        <!-- DETAILS -->
        <text value="DETAILS" font-family="SF Pro Display" font-size="13" font-weight="700" letter-spacing="1" text-case="uppercase" color="$muted" pt="26" pb="12" pl="4" />
        <grid cols="2" gap="14" w="fill">
          <instance component="comp-metric" lab="💧 Humidity" val="62%" note="Comfortable" />
          <instance component="comp-metric" lab="🌬️ Wind" val="12 km/h" note="Light breeze · NW" />
          <instance component="comp-metric" lab="☀️ UV Index" val="5" note="Moderate" />
          <instance component="comp-metric" lab="🌅 Sunset" val="7:42" note="Sunrise 6:18 AM" />
        </grid>
      </col>

    <!-- TAB BAR (was position:fixed → now bottom of the expanded screen) -->
    <row w="fill" h="84" fill="#FDF6F0CC" border-top="1 #0000000D" p="12 24 0" gap="auto" align="top-center" role="tab-bar">
      <col gap="4" align="middle-center">
        <img src="https://api.iconify.design/lucide/sun.svg?color=%23ff8a65" w="24" h="24" />
        <text value="Weather" font-family="SF Pro Display" font-size="11" font-weight="600" color="$accent" />
      </col>
      <col gap="4" align="middle-center">
        <img src="https://api.iconify.design/lucide/map-pin.svg?color=%239a93a0" w="24" h="24" />
        <text value="Map" font-family="SF Pro Display" font-size="11" font-weight="600" color="$muted" />
      </col>
      <col gap="4" align="middle-center">
        <img src="https://api.iconify.design/lucide/calendar.svg?color=%239a93a0" w="24" h="24" />
        <text value="Cities" font-family="SF Pro Display" font-size="11" font-weight="600" color="$muted" />
      </col>
      <col gap="4" align="middle-center">
        <img src="https://api.iconify.design/lucide/settings.svg?color=%239a93a0" w="24" h="24" />
        <text value="Settings" font-family="SF Pro Display" font-size="11" font-weight="600" color="$muted" />
      </col>
    </row>

  </col>
</gui>
